---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/studio.css";
import config from "@/config";
---

<Layout title={`登录 | ${config.site.title}`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
    data-pagefind-ignore
  >
    <div class="studio-shell" style="max-width:420px">
      <div id="login-app" class="studio-root">
        <div class="studio-card">
          <h1>登录 FluxBlog</h1>
          <form id="login-form">
            <input
              name="username"
              placeholder="用户名"
              required
              autocomplete="username"
            />
            <div class="password-wrap">
              <input
                id="login-password"
                name="password"
                type="password"
                placeholder="密码"
                required
                autocomplete="current-password"
              />
              <button
                type="button"
                id="pwd-toggle"
                class="password-toggle"
                aria-label="显示密码"
                aria-pressed="false"
                tabindex="-1"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
            <button type="submit">登录</button>
          </form>
          <p class="studio-hint">博客账号登录；admin 账号也可直接用同一套凭据登录预览页。</p>
          <p id="login-error" class="studio-hint" hidden style="color:var(--accent)"></p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { login, isLoggedIn } from "@/scripts/auth";

  const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

  // 支持 ?next=<path>：预览页未登录被弹回时，登录成功后回到原页。
  // next 必须是站内相对路径（防 open redirect：不允许 // 或协议绝对 URL）。
  function nextUrl(): string | null {
    const v = new URLSearchParams(location.search).get("next");
    if (!v) return null;
    if (/^\/[^/]/.test(v) || v === "/") return v;
    return null;
  }

  const redirectTo = nextUrl() ?? `${base}studio/`;

  // 已登录则直接跳目标。
  if (isLoggedIn()) {
    location.replace(redirectTo);
  }

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errEl = document.getElementById("login-error")!;

  // Password visibility toggle: swap input[type] and eye/eye-off SVG in place.
  const pwdInput = document.getElementById("login-password") as HTMLInputElement;
  const pwdToggle = document.getElementById("pwd-toggle") as HTMLButtonElement;
  const eyeSvg = pwdToggle.innerHTML;
  const eyeOffSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a19.79 19.79 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a19.76 19.76 0 0 1-4 5.19M14.12 14.12a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
  pwdToggle.addEventListener("click", () => {
    const show = pwdInput.type === "password";
    pwdInput.type = show ? "text" : "password";
    pwdToggle.setAttribute("aria-label", show ? "隐藏密码" : "显示密码");
    pwdToggle.setAttribute("aria-pressed", String(show));
    pwdToggle.innerHTML = show ? eyeOffSvg : eyeSvg;
  });

  form.addEventListener("submit", async e => {
    e.preventDefault();
    errEl.hidden = true;
    const fd = new FormData(form);
    const ok = await login(
      String(fd.get("username")),
      String(fd.get("password"))
    );
    if (!ok) {
      errEl.textContent = "用户名或密码错误";
      errEl.hidden = false;
      return;
    }
    location.replace(redirectTo);
  });
</script>
