---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { searchPublic } from "@/utils/blogApi";
import { useTranslations } from "@/i18n";
import config from "@/config";

// 搜索改为后端 ILIKE 全文检索（替换 Pagefind 构建期索引）。
export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const rawQ = Astro.url.searchParams.get("q") ?? "";
const q = rawQ.trim();
const result = q ? await searchPublic(q) : null;
const items = result?.items ?? [];
---

<Layout title={`${t.pages.searchTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.searchTitle} pageDesc={t.pages.searchDesc}>
    <form method="get" class="mb-6 flex gap-2">
      <input
        type="search"
        name="q"
        value={q}
        placeholder={t.pages.searchTitle}
        class="border-border bg-background text-foreground flex-1 rounded border px-3 py-2"
        autofocus
      />
      <button type="submit" class="bg-accent text-accent-foreground rounded px-4 py-2">
        {t.pages.searchTitle}
      </button>
    </form>

    {
      q && (
        <p class="text-muted-foreground mb-4 text-sm">
          {items.length > 0
            ? `${items.length} ${t.pages.searchTitle}`
            : t.pages.searchDesc}
        </p>
      )
    }

    <ul>
      {items.map(post => <Card variant="h3" post={post} />)}
    </ul>
  </Main>

  <Footer />
</Layout>

<script>
  // 保留返回页 backUrl（与其它列表页一致）。
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector<HTMLElement>("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) sessionStorage.setItem("backUrl", backUrl);
  });
</script>
