---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { listPublicProjects } from "@/utils/blogApi";
import { getProjectUrlByID } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const prerender = false;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = await listPublicProjects();
---

<Layout title={`${t.pages.projectsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.projectsTitle} pageDesc={t.pages.projectsDesc}>
    {projects.length === 0 ? (
      <p class="text-muted-foreground">暂无项目。</p>
    ) : (
      <ul>
        {projects.map(p => (
          <li class="my-6">
            <a
              href={getProjectUrlByID(p.id, Astro.currentLocale)}
              class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              {p.name}
            </a>
            <span class="text-muted-foreground ml-2 text-sm">({p.postCount} 篇)</span>
            {p.intro && <p class="mt-1">{p.intro}</p>}
          </li>
        ))}
      </ul>
    )}
  </Main>

  <Footer />
</Layout>