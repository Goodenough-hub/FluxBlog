---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getPublicProject, listPublicPosts } from "@/utils/blogApi";
import config from "@/config";

export const prerender = false;

const idStr = Astro.params.id;
const id = parseInt(idStr ?? "", 10);
if (isNaN(id) || id <= 0) {
  return new Response("Not Found", { status: 404 });
}

let project;
try {
  project = await getPublicProject(id);
} catch {
  return new Response("Not Found", { status: 404 });
}

const posts = await listPublicPosts(id);
---

<Layout title={`${project.name} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={project.name}
    pageDesc={project.intro || `${posts.length} 篇文章`}
  >
    {posts.length === 0 ? (
      <p class="text-muted-foreground">暂无文章。</p>
    ) : (
      <ul>
        {posts.map(post => <Card post={post} />)}
      </ul>
    )}
  </Main>

  <Footer />
</Layout>