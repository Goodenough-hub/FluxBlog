---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { listAllPostsForAdmin } from "@/utils/blogApi";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

// admin 预览单标签下的文章列表（SSR）。URL: /preview/tags/<tag>、/preview/tags/<tag>/2。
// 无登录/令牌失效 → 跳博客登录页。
export const prerender = false;

const tag = Astro.params.tag ?? "";
const pageStr = Astro.params.page;
const hasPageParam = !!pageStr;
const currentPage = pageStr && /^\d+$/.test(pageStr) ? parseInt(pageStr, 10) : 1;

const locale = Astro.currentLocale ?? config.site.lang;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const loginUrl = `${base}login/?next=${encodeURIComponent(Astro.url.pathname)}`;

if (!tag) {
  return new Response("Not Found", { status: 404 });
}

const token = Astro.cookies.get("fluxblog_token")?.value;
if (!token) {
  return Astro.redirect(loginUrl, 302);
}

let all;
try {
  all = await listAllPostsForAdmin(token);
} catch {
  return Astro.redirect(loginUrl, 302);
}

const tagName =
  all.flatMap(p => p.tags ?? []).find(name => slugifyStr(name) === tag) ?? tag;

const tagPosts = all.filter(p => (p.tags ?? []).some(name => slugifyStr(name) === tag));
const perPage = config.posts.perPage;
const lastPage = Math.max(1, Math.ceil(tagPosts.length / perPage));

if (hasPageParam && (currentPage < 2 || currentPage > lastPage)) {
  return Astro.redirect(getRelativeLocaleUrl(locale, `preview/tags/${tag}`), 302);
}

const slice = tagPosts.slice((currentPage - 1) * perPage, currentPage * perPage);

const tagsBase = getRelativeLocaleUrl(locale, `preview/tags/${tag}`);
const pageUrl = (n: number) => `${tagsBase}/${n}`;
const prevUrl = currentPage > 1 ? pageUrl(currentPage - 1) : undefined;
const nextUrl = currentPage < lastPage ? pageUrl(currentPage + 1) : undefined;
---

<Layout title={`标签: ${tagName} | ${config.site.title}`}>
  <Header linkBase="preview" />

  <Breadcrumb linkBase="preview" />

  <Main
    pageTitle={`标签: ${tagName}`}
    pageDesc={`包含标签 "${tagName}" 的文章（含私有）。`}
  >
    <ul>
      {slice.map(post => <Card post={post} linkBase="preview" />)}
    </ul>
  </Main>

  <Pagination
    currentPage={currentPage}
    lastPage={lastPage}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
  />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
