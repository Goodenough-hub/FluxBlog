---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { listAllPostsForAdmin } from "@/utils/blogApi";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

// admin 预览标签索引（SSR）：从所有已发布文章（公开+私有）聚合标签。
// 无登录/令牌失效 → 跳博客登录页。
export const prerender = false;

const token = Astro.cookies.get("fluxblog_token")?.value;
const locale = Astro.currentLocale ?? config.site.lang;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const loginUrl = `${base}login/?next=${encodeURIComponent(Astro.url.pathname)}`;

if (!token) {
  return Astro.redirect(loginUrl, 302);
}

let posts;
try {
  posts = await listAllPostsForAdmin(token);
} catch {
  return Astro.redirect(loginUrl, 302);
}

type TagEntry = { tag: string; tagName: string };
const seen = new Map<string, TagEntry>();
for (const p of posts) {
  for (const tagName of p.tags ?? []) {
    const tag = slugifyStr(tagName);
    if (!seen.has(tag)) seen.set(tag, { tag, tagName });
  }
}
const tags = [...seen.values()].sort((a, b) => a.tag.localeCompare(b.tag));
---

<Layout title={`标签预览 | ${config.site.title}`}>
  <Header linkBase="preview" />

  <Breadcrumb linkBase="preview" />

  <Main pageTitle="标签预览" pageDesc="所有标签（含私有文章），仅 admin 可见。">
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => <Tag {tag} {tagName} linkBase="preview" />)}
    </ul>
  </Main>

  <Footer />
</Layout>
