---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import ContributionGraph from "@/components/ContributionGraph.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { listAllPostsForAdmin } from "@/utils/blogApi";
import { joinPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

// admin 预览列表第 1 页（SSR）。无登录/令牌失效 → 跳博客登录页（支持 admin 凭据）。
// 与 /posts/ 同款 Card/Pagination 渲染，但数据源是 /admin-preview/posts（含私有）。
export const prerender = false;

const token = Astro.cookies.get("fluxblog_token")?.value;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const loginUrl = `${base}login/?next=${encodeURIComponent(Astro.url.pathname)}`;

if (!token) {
  return Astro.redirect(loginUrl, 302);
}

let all: Awaited<ReturnType<typeof listAllPostsForAdmin>>;
try {
  all = await listAllPostsForAdmin(token);
} catch {
  return Astro.redirect(loginUrl, 302);
}

const perPage = config.posts.perPage;
const lastPage = Math.max(1, Math.ceil(all.length / perPage));
const slice = all.slice(0, perPage);

const previewBase = getRelativeLocaleUrl(locale, "preview");
const pageUrl = (n: number) => joinPath(previewBase, "page", n);
const nextUrl = lastPage > 1 ? pageUrl(2) : undefined;
---

<Layout title={`博客预览 | ${config.site.title}`}>
  <Header linkBase="preview" />

  <Breadcrumb linkBase="preview" />

  <Main
    pageTitle="博客预览"
    pageDesc="所有已发布文章（公开 + 私有），仅 admin 可见。"
  >
    <ContributionGraph
      posts={all}
      labels={t.preview.contribution}
      showPrivateCounts={true}
      class="pb-8"
    />
    <ul>
      {slice.map(post => <Card post={post} linkBase="preview" />)}
    </ul>
  </Main>

  <Pagination
    currentPage={1}
    lastPage={lastPage}
    prevUrl={undefined}
    nextUrl={nextUrl}
  />

  <Footer noMarginTop={lastPage > 1} />
</Layout>
