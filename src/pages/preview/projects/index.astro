---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { listAllProjectsForAdmin } from "@/utils/blogApi";
import config from "@/config";

// admin 预览项目列表（SSR）。无登录/令牌失效 → 跳博客登录页（支持 admin 凭据）。
// 与 /projects/ 同款渲染，但数据源是 /admin-preview/projects（含私有文章计数）。
export const prerender = false;

const token = Astro.cookies.get("fluxblog_token")?.value;
const locale = Astro.currentLocale ?? config.site.lang;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const loginUrl = `${base}login/?next=${encodeURIComponent(Astro.url.pathname)}`;

if (!token) {
  return Astro.redirect(loginUrl, 302);
}

let projects;
try {
  projects = await listAllProjectsForAdmin(token);
} catch {
  return Astro.redirect(loginUrl, 302);
}

const projectUrl = (id: number) => getRelativeLocaleUrl(locale, `preview/projects/${id}`);
---

<Layout title={`项目预览 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="项目预览" pageDesc="所有项目（含私有文章计数），仅 admin 可见。">
    {projects.length === 0 ? (
      <p class="text-muted-foreground">暂无项目。</p>
    ) : (
      <ul>
        {projects.map(p => (
          <li class="my-6">
            <a
              href={projectUrl(p.id)}
              class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              {p.name}
            </a>
            <span class="text-muted-foreground ml-2 text-sm">({p.postCount} 篇)</span>
            {p.intro && <p class="mt-1">{p.intro}</p>}
          </li>
        ))}
      </ul>
    )}
  </Main>

  <Footer />
</Layout>
