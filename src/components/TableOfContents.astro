---
// 文章目录（飞书文档大纲风格）
// - 服务端渲染 TOC 列表（从 markdown 提取 headings 作为 props）
// - sticky 定位，与正文并排（.app-layout flex 布局）
// - 视觉：细引导线 + 节点圆点 + 胶囊状悬浮/激活态（强调色 pill）
// - 当前可见 heading：激活项 accent 胶囊背景 + 圆点加粗放大
// - CSS transition 平滑切换激活态、点击平滑滚动、宽屏（≥1280px）以下隐藏
import type { TocHeading } from "@/utils/extractHeadings";
export interface Props {
  headings: TocHeading[];
}
const { headings } = Astro.props;
if (headings.length === 0) return;
---

<aside
  id="toc-aside"
  class="toc"
  aria-label="目录"
>
  <p class="toc-label">目录</p>
  <nav>
    <ol class="toc-list">
      {
        headings.map((h) => (
          <li class="toc-item" data-depth={h.depth}>
            <a
              href={`#${h.id}`}
              class="toc-link"
              data-toc-link
              data-toc-id={h.id}
            >
              {h.text}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  .toc {
    position: sticky;
    top: 5.5rem;
    align-self: flex-start;
    flex-shrink: 0;
    width: 15rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding: 0.25rem 0.75rem 0.25rem 0;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 1279.98px) {
    .toc { display: none; }
  }

  /* 标题：小字 + 右侧虚线分隔，弱化存在感 */
  .toc-label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 0.625rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .toc-label::after {
    content: "";
    flex: 1;
    border-top: 1px dashed var(--color-border);
  }

  .toc-list {
    list-style: none;
    position: relative;
    margin: 0;
    padding: 0;
  }

  /* 细引导线：贯穿整个目录，节点圆点挂在线上 */
  .toc-list::before {
    content: "";
    position: absolute;
    left: 3px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    border-radius: 2px;
    background: var(--color-border);
    opacity: 0.6;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
    margin: 0.0625rem 0;
    padding: 0.28rem 0.625rem;
    border-radius: 8px;
    color: var(--color-muted-foreground);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  /* 节点圆点 */
  .toc-link::before {
    content: "";
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--color-border);
    transition:
      background 0.15s ease,
      transform 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-foreground);
    background: color-mix(in srgb, var(--color-muted) 55%, transparent);
  }
  .toc-link:hover::before {
    background: var(--color-muted-foreground);
  }

  /* 层级缩进：h3 缩进更深、更小的点与字 */
  .toc-item[data-depth="3"] .toc-link {
    padding-inline-start: 1.625rem;
    font-size: 0.75rem;
  }
  .toc-item[data-depth="3"] .toc-link::before {
    width: 3px;
    height: 3px;
  }

  /* 激活项：强调色胶囊 + 圆点强调放大 */
  .toc-link.active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
    font-weight: 500;
  }
  .toc-link.active::before {
    background: var(--color-accent);
    transform: scale(1.4);
  }

  /* 滚动条 */
  .toc::-webkit-scrollbar { width: 4px; }
  .toc::-webkit-scrollbar-thumb {
    background: var(--color-muted);
    border-radius: 2px;
  }
  .toc {
    scrollbar-width: thin;
    scrollbar-color: var(--color-muted) transparent;
  }
</style>

<script is:inline>
  (function () {
    // DOMContentLoaded 后初始化 scroll spy
    function init() {
      const links = Array.from(
        document.querySelectorAll(".toc-link[data-toc-id]")
      );
      if (links.length === 0) return;

      const linkById = new Map();
      for (const a of links) {
        linkById.set(a.dataset.tocId, a);
      }

      const headings = Array.from(
        document.querySelectorAll("h2[id], h3[id]")
      ).filter((h) => linkById.has(h.id));

      if (headings.length === 0) return;

      let currentActive = null;

      const observer = new IntersectionObserver(
        (entries) => {
          let best = null;
          let bestTop = Infinity;
          for (const e of entries) {
            if (e.isIntersecting && e.boundingClientRect.top < bestTop) {
              best = e.target;
              bestTop = e.boundingClientRect.top;
            }
          }
          if (!best) {
            for (const h of headings) {
              const rect = h.getBoundingClientRect();
              if (rect.top > 80) break;
              best = h;
            }
          }
          if (!best) return;
          const link = linkById.get(best.id);
          if (!link || link === currentActive) return;
          if (currentActive) currentActive.classList.remove("active");
          link.classList.add("active");
          currentActive = link;

          const nav = link.closest("nav");
          if (nav) {
            const nr = nav.getBoundingClientRect();
            const lr = link.getBoundingClientRect();
            if (lr.top < nr.top + 20 || lr.bottom > nr.bottom - 20) {
              link.scrollIntoView({ block: "nearest" });
            }
          }
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: [0, 1] }
      );

      for (const h of headings) observer.observe(h);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>