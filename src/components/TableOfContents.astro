---
// 文章目录（Josh Comeau / Lee Robinson 风格）
// - 服务端渲染 TOC 列表（从 markdown 提取 headings 作为 props）
// - sticky 定位，贴右侧或左侧
// - 当前可见 heading：左侧 2px 强调色竖条 + 加粗 + 强调色文字
// - CSS transition 平滑切换激活态
// - 点击平滑滚动
// - 移动端隐藏
import type { TocHeading } from "@/utils/extractHeadings";
export interface Props {
  headings: TocHeading[];
}
const { headings } = Astro.props;
if (headings.length === 0) return;
---

<aside
  id="toc-aside"
  class="toc"
  aria-label="目录"
>
  <p class="toc-label">目录</p>
  <nav>
    <ol class="toc-list">
      {
        headings.map((h) => (
          <li class="toc-item" data-depth={h.depth}>
            <a
              href={`#${h.id}`}
              class="toc-link"
              data-toc-link
              data-toc-id={h.id}
            >
              {h.text}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  .toc {
    position: sticky;
    top: 5rem;
    align-self: flex-start;
    flex-shrink: 0;
    width: 20rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding: 0.5rem 0 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    /* 左侧分隔线，贴近正文内容 */
    border-left: 1px solid var(--color-border);
  }

  @media (max-width: 1279.98px) {
    .toc { display: none; }
  }

  .toc-label {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-link {
    display: block;
    padding: 0.2rem 0.5rem 0.2rem 0.75rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-radius: 0 4px 4px 0;
  }

  .toc-link:hover {
    color: var(--color-foreground);
    background: var(--color-muted);
  }

  /* 层级缩进 */
  .toc-item[data-depth="3"] .toc-link {
    padding-inline-start: 1.5rem;
    font-size: 0.8125rem;
  }

  /* 当前激活项 */
  .toc-link.active {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    font-weight: 500;
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  /* 滚动条 */
  .toc::-webkit-scrollbar { width: 4px; }
  .toc::-webkit-scrollbar-thumb {
    background: var(--color-muted);
    border-radius: 2px;
  }
  .toc {
    scrollbar-width: thin;
    scrollbar-color: var(--color-muted) transparent;
  }
</style>

<script is:inline>
  (function () {
    // DOMContentLoaded 后初始化 scroll spy
    function init() {
      const links = Array.from(
        document.querySelectorAll(".toc-link[data-toc-id]")
      );
      if (links.length === 0) return;

      const linkById = new Map();
      for (const a of links) {
        linkById.set(a.dataset.tocId, a);
      }

      const headings = Array.from(
        document.querySelectorAll("h2[id], h3[id]")
      ).filter((h) => linkById.has(h.id));

      if (headings.length === 0) return;

      let currentActive = null;

      const observer = new IntersectionObserver(
        (entries) => {
          let best = null;
          let bestTop = Infinity;
          for (const e of entries) {
            if (e.isIntersecting && e.boundingClientRect.top < bestTop) {
              best = e.target;
              bestTop = e.boundingClientRect.top;
            }
          }
          if (!best) {
            for (const h of headings) {
              const rect = h.getBoundingClientRect();
              if (rect.top > 80) break;
              best = h;
            }
          }
          if (!best) return;
          const link = linkById.get(best.id);
          if (!link || link === currentActive) return;
          if (currentActive) currentActive.classList.remove("active");
          link.classList.add("active");
          currentActive = link;

          const nav = link.closest("nav");
          if (nav) {
            const nr = nav.getBoundingClientRect();
            const lr = link.getBoundingClientRect();
            if (lr.top < nr.top + 20 || lr.bottom > nr.bottom - 20) {
              link.scrollIntoView({ block: "nearest" });
            }
          }
        },
        { rootMargin: "-80px 0px -70% 0px", threshold: [0, 1] }
      );

      for (const h of headings) observer.observe(h);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>